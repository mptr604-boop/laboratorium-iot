# Zmienne środowiskowe aplikacji (skopiuj do .env i dostosuj)

PORT=3000
PORT_TCP=4000
NODE_ENV=development

# Logowanie: debug | info | warn | error | silent (domyślnie info)
LOG_LEVEL=info
# json (domyślnie, jedna linia JSON na zdarzenie) albo pretty (czytelne w terminalu)
LOG_FORMAT=pretty

# Bezpieczeństwo i sesje
JWT_SECRET=twoj_tajny_losowy_klucz_jwt_min_32_znaki_2026

# Seed bazy danych
SEED_DEFAULT_PASSWORD=laboratorium2026

# Opcjonalne: flaga uruchomienia w kontenerze Docker
IS_DOCKER=false
